# Copy this file to .env and fill in your values:
#   cp .env.example .env
# Never commit your real .env file.

# Required: your OpenAI API key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=your-openai-api-key-here

# Optional: model and creativity (0 = consistent, 1 = creative)
MODEL_NAME=gpt-4.1-mini
TEMPERATURE=0.2

# Optional: safety and cost limits
MAX_REVIEWS=500          # maximum reviews analysed per run
MAX_REVIEW_CHARS=4000    # longer reviews are truncated before sending
MAX_CONCURRENCY=5        # parallel requests to the LLM
MAX_RETRIES=3            # attempts per review before marking it failed
