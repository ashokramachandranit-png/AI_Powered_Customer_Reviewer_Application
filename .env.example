# Copy this file to .env and fill in your values:
#   cp .env.example .env
# Never commit your real .env file.
# On Streamlit Cloud, put the same keys in the app's Secrets instead.

# LLM provider: openai (default), anthropic or gemini
LLM_PROVIDER=openai

# API key for the selected provider (only that one is needed)
OPENAI_API_KEY=your-openai-api-key-here
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
# GOOGLE_API_KEY=your-google-api-key-here

# Optional: model (empty = provider default:
#   openai gpt-4.1-mini, anthropic claude-opus-5-5, gemini gemini-2.5-flash)
MODEL_NAME=

# Optional: 0 = consistent, 1 = creative. Ignored for anthropic
# (current Claude models do not accept sampling parameters).
TEMPERATURE=0.2

# Optional: safety and cost limits
MAX_REVIEWS=500          # maximum reviews analysed per run
MAX_REVIEW_CHARS=4000    # longer reviews are truncated before sending
MAX_CONCURRENCY=5        # parallel requests to the LLM
MAX_RETRIES=3            # attempts per review before it is marked failed
